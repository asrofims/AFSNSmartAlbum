{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AFSNSmartAlbum",
  "version": "1.0.8",
  "identifier": "com.afsn.smartalbum",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AFSNSmartAlbum",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#18181b",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.github.com https://github.com https://objects.githubusercontent.com; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob: https://avatars.githubusercontent.com;",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp",
        "installMode": "both",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerHooks": "hooks.nsh",
        "compression": "lzma"
      }
    },
    "fileAssociations": [
      {
        "ext": ["afsn"],
        "name": "AFSNSmartAlbum Project",
        "description": "AFSNSmartAlbum Project File",
        "role": "Editor"
      },
      {
        "ext": ["afsnz"],
        "name": "AFSNSmartAlbum Complete Archive",
        "description": "AFSNSmartAlbum Complete Project Archive",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
